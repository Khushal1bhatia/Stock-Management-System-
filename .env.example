# Copy to .env and set strong values.
# Local development uses SQLite:
DATABASE_URL="file:./dev.db"

# On Vercel, set these in Project -> Settings -> Environment Variables instead:
# DATABASE_URL="postgresql://USER:PASSWORD@HOST-pooler/DB?sslmode=require"
# DIRECT_URL="postgresql://USER:PASSWORD@HOST/DB?sslmode=require"

SEED_ADMIN_USERNAME="aso.admin"
SEED_ADMIN_PASSWORD="replace-with-a-strong-password"
SEED_ADMIN_NAME="Avery Morgan"
SEED_OPERATOR_USERNAME="aso.user"
SEED_OPERATOR_PASSWORD="replace-with-a-strong-password"
